LOG_LEVEL=INFO
LOG_FORMAT={% if cookiecutter.generate_local_otel_stack == "yes" %}json{% else %}stdout{% endif %}
ROOT_PATH=
{%- if cookiecutter.project_type in ["fastapi_db", "fastapi_db_agent"] %}

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER={{ cookiecutter.project_name | lower }}_user
DATABASE_PASSWORD={{ cookiecutter.project_name | lower }}_password
DATABASE_NAME={{ cookiecutter.project_name | lower }}_db
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_READINESS_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_SECONDS=10
# libpq reads PG* variables from the process environment, not from this file: set PGSSLMODE=verify-full in production.
MIGRATION_ON_STARTUP=False
{%- endif %}
{%- if cookiecutter.project_type in ["fastapi_agent", "fastapi_db_agent"] %}

AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

OPENAI_API_KEY=change-me
OPENAI_BASE_URL=
OPENAI_GPT_5_4_MODEL_NAME=gpt-5.4
OPENAI_GPT_5_4_MINI_MODEL_NAME=gpt-5.4-mini
OPENAI_GPT_5_2_MODEL_NAME=gpt-5.2
OPENAI_GPT_5_1_MODEL_NAME=gpt-5.1

BEDROCK_CONNECT_TIMEOUT_SECONDS=5
BEDROCK_READ_TIMEOUT_SECONDS=180
BEDROCK_CONNECTIONS_POOL_SIZE=30
BEDROCK_MODEL_SONNET_4_6=eu.anthropic.claude-sonnet-4-6-20260101-v1:0
BEDROCK_MODEL_OPUS_4_6=eu.anthropic.claude-opus-4-6-20260101-v1:0
BEDROCK_MODEL_HAIKU_4_5=eu.anthropic.claude-haiku-4-5-20251001-v1:0
{%- endif %}
{%- if cookiecutter.use_otel_observability == "yes" %}
{%- if cookiecutter.generate_local_otel_stack == "yes" %}

OBSERVABILITY_TRACING_ENABLED=true
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_TRACING_OTLP_ENDPOINT=http://localhost:4317
OBSERVABILITY_TRACING_SAMPLE_RATE_PERCENT=100
{%- else %}

OBSERVABILITY_METRICS_ENABLED=false
OBSERVABILITY_TRACING_ENABLED=false
# Set an OTLP endpoint and flip OBSERVABILITY_TRACING_ENABLED=true to export traces.
# Scheme selects transport/TLS: http/grpc = plaintext, https/grpcs = TLS.
# OBSERVABILITY_TRACING_OTLP_ENDPOINT=http://localhost:4317
# OBSERVABILITY_TRACING_SAMPLE_RATE_PERCENT=100
{%- endif %}
{%- endif %}
